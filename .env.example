# Required for the early-access form. Must accept POST JSON and return a 2xx response.
VITE_WAITLIST_ENDPOINT=https://example.com/api/waitlist

# Optional design-partner scheduling destination.
VITE_BOOKING_URL=https://cal.com/example/o11y

# Optional PostHog monitoring. Both values are required to enable analytics.
VITE_POSTHOG_KEY=phc_example
VITE_POSTHOG_HOST=https://us.i.posthog.com
